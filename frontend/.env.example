# Copy this file to .env.local for local development.

NEXT_PUBLIC_API_URL=http://localhost:5000

# Cloudinary — for product image uploads from the admin panel (free tier).
# Create an account at https://cloudinary.com, then Settings → Upload →
# add an "Unsigned" upload preset, and put its values here.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=safcajaf
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=techarcade_preset
