# Server
PORT=5000
NODE_ENV=production
# MongoDB (get a free cluster at https://www.mongodb.com/atlas)
MONGO_URI=mongodb+srv://Tech_Arcade:Gc86dnlNKG1qo28e@cluster0.o8vsjxo.mongodb.net/tech_arcade?retryWrites=true&w=majority

# Auth — access token (short-lived, in an HttpOnly cookie) + refresh token rotation.
# Generate a random 64-char string for this, e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET=techarcade47Dina$anto@
ACCESS_TOKEN_EXPIRES=1d
REFRESH_TOKEN_EXPIRES_DAYS=30

# Admin bootstrap account (only used once, on first server start, to create the first admin)
ADMIN_EMAIL=techarcade47@gmail.com
ADMIN_PASSWORD=49141726863789SantoDina

# SSLCommerz — OPTIONAL, only needed once you have a trade license and enable
# the "sslcommerz" payment option again in the checkout page. Leave as-is until then.
# Sign up at https://developer.sslcommerz.com for a free sandbox account.
SSLCOMMERZ_STORE_ID=your_store_id
SSLCOMMERZ_STORE_PASSWORD=your_store_password
SSLCOMMERZ_IS_LIVE=false

# SMS gateway for OTP login — see backend/utils/sms.js for how these are used.
# LEAVE SMS_API_URL BLANK to test the full OTP flow without any gateway —
# codes will just be printed to the server console (and returned in the API
# response when NODE_ENV is not "production", so you can log in during testing).
# Once you have a phone-as-gateway app (for SIM-based sending) or a paid
# provider, fill these in — no code changes needed.
SMS_API_URL=
SMS_METHOD=GET
SMS_PHONE_PARAM=to
SMS_MESSAGE_PARAM=message
SMS_API_KEY_PARAM=api_key
SMS_API_KEY=
SMS_EXTRA_PARAMS={}

# Email (for "forgot password" and account notices) — works with any SMTP
# provider. LEAVE SMTP_HOST BLANK to test the flow without sending real email
# (reset links get logged to the server console instead).
# Free options: Gmail SMTP (use an "app password", not your real password),
# Brevo (300 free emails/day), Resend (free tier).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=techarcade47@gmail.com
SMTP_PASS=gqygauokajflrxod
EMAIL_FROM=techarcade47@gmail.com

# Automated backups (optional — only needed if using Docker + VPS deployment,
# see backend/scripts/backup.js). Create a free-tier AWS S3 bucket for this.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
S3_BACKUP_BUCKET=
BACKUP_RETENTION_DAYS=30
BACKUP_CRON_SCHEDULE=0 3 * * *

# Public URLs (used for SSLCommerz redirect + your frontend CORS)
BACKEND_URL=https://tech-arcade-bd-backend.onrender.com
FRONTEND_URL=https://tech-arcade-bd.vercel.app

# bKash/Nagad personal numbers and WhatsApp number are NOT set here — configure
# them from the admin panel's "Payment settings" tab after your first login.
